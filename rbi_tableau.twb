      <table>
        <view>
          <datasources>
            <datasource caption='RBI_Sectoral_Wide' name='federated.0dbw11r1wurwfg14xqk9n019wgng' />
          </datasources>
          <datasource-dependencies datasource='federated.0dbw11r1wurwfg14xqk9n019wgng'>
            <column caption='Outstanding May2026' datatype='real' name='[Outstanding_May2026]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sector]' role='dimension' type='nominal' />
            <column caption='YoY Growth May2026' datatype='real' name='[YoY_Growth_May2026]' role='dimension' type='quantitative' />
            <column-instance column='[Outstanding_May2026]' derivation='None' name='[none:Outstanding_May2026:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Sector]' derivation='None' name='[none:Sector:nk]' pivot='key' type='nominal' />
            <column-instance column='[YoY_Growth_May2026]' derivation='None' name='[none:YoY_Growth_May2026:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Outstanding_May2026]' derivation='Sum' name='[sum:Outstanding_May2026:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dbw11r1wurwfg14xqk9n019wgng].[Exclusions (Outstanding May2026,Sector,YoY Growth May2026 2)]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:Outstanding_May2026:ok]' />
                <groupfilter function='level-members' level='[none:Sector:nk]' />
                <groupfilter function='level-members' level='[none:YoY_Growth_May2026:qk]' />
              </groupfilter>
              <groupfilter function='crossjoin'>
                <groupfilter function='member' level='[none:Outstanding_May2026:ok]' member='%null%' />
                <groupfilter function='crossjoin'>
                  <groupfilter function='member' level='[none:Sector:nk]' member='&quot;Notes:&#13;&#10;(1) Data are provisional.  Bank credit, Food credit and Non-food credit data are based on fortnightly Section-42 return, which covers all scheduled commercial banks (SCBs), while sectoral non-food credit data are based on sector-wise and industry-wise bank credit (SIBC) return, which covers select banks accounting for about 95 per cent of total non-food credit extended by all SCBs.  Data for the fortnights corresponding to the Section-42 fortnights are not available for the SIBC return. Therefore, reference periods (fortnights dates) considered for arriving sectoral non-food credit growth rates are different than the reference period for arriving growth rates of Section-42 data.&quot;' />
                  <groupfilter function='member' level='[none:YoY_Growth_May2026:qk]' member='%null%' />
                </groupfilter>
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0dbw11r1wurwfg14xqk9n019wgng].[none:Sector:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Sector:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;(2) With effect from December 31, 2025, definition of last reporting fortnight has been changed to the last day of the month under the Banking Laws (Amendment) Act 2025. Accordingly, the y-o-y growth rates from December 2025 onwards are based on end-of-month data for the current year and data for the last reporting fortnight (as per old definition) for the corresponding month of the previous year.&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;4 Since May 2024, a bank has changed the classification of a category of agricultural loan into “Loans against gold jewellery” under retail segment.&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;I. Bank Credit (II + III)&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;II. Food Credit&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;III. Non-food Credit&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;Notes:&#13;&#10;(1) Data are provisional.  Bank credit, Food credit and Non-food credit data are based on fortnightly Section-42 return, which covers all scheduled commercial banks (SCBs), while sectoral non-food credit data are based on sector-wise and industry-wise bank credit (SIBC) return, which covers select banks accounting for about 95 per cent of total non-food credit extended by all SCBs.  Data for the fortnights corresponding to the Section-42 fortnights are not available for the SIBC return. Therefore, reference periods (fortnights dates) considered for arriving sectoral non-food credit growth rates are different than the reference period for arriving growth rates of Section-42 data.&quot;' />
                <groupfilter function='member' level='[none:Sector:nk]' member='&quot;Priority Sector (Memo)&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.0dbw11r1wurwfg14xqk9n019wgng].[sum:Outstanding_May2026:qk]' included-values='non-null' />
          <slices>
            <column>[federated.0dbw11r1wurwfg14xqk9n019wgng].[none:Sector:nk]</column>
            <column>[federated.0dbw11r1wurwfg14xqk9n019wgng].[Exclusions (Outstanding May2026,Sector,YoY Growth May2026 2)]</column>
            <column>[federated.0dbw11r1wurwfg14xqk9n019wgng].[sum:Outstanding_May2026:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
